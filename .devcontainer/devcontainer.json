{
	"name": "RTA: Native PyRIT and Foundry",
	"image": "mcr.microsoft.com/playwright/python:v1.51.0-noble",
	"features": {
		"ghcr.io/devcontainers/features/azure-cli:1": {
			"version": "latest"
		},
		"ghcr.io/devcontainers/features/python:1": {
			"installTools": true,
			"version": "3.11"
		}
	},
	"containerEnv": {
		"XDG_DATA_HOME": "/data",
		"PIP_INDEX_URL": "https://packagefeedproxy.microsoft.io/pypi/simple"
	},
	"mounts": [
		"source=rta-pyrit-data,target=/data,type=volume"
	],
	"forwardPorts": [8014],
	"portsAttributes": {
		"8014": {
			"label": "Co-PyRIT",
			"onAutoForward": "notify"
		}
	},
	"postCreateCommand": "python -m pip install --upgrade pip && python -m pip install -e '.[dev,foundry,playwright]' && playwright install --with-deps chromium && rta validate --config configs/redteam.yaml"
}