FROM python:3.11-slim

ARG PIP_INDEX_URL=https://packagefeedproxy.microsoft.io/pypi/simple

ENV PIP_INDEX_URL=${PIP_INDEX_URL} \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PLAYWRIGHT_BROWSERS_PATH=/ms-playwright

WORKDIR /app

COPY pyproject.toml README.md LICENSE ./
COPY src ./src

RUN python -m pip install --no-cache-dir ".[foundry,playwright]" \
    && playwright install --with-deps chromium \
    && useradd --create-home --shell /usr/sbin/nologin accelerator \
    && chown -R accelerator:accelerator /app /ms-playwright

RUN mkdir -p /data && chown accelerator:accelerator /data

COPY --chown=accelerator:accelerator configs ./configs

USER accelerator

ENTRYPOINT ["pyrit_scan"]
CMD ["--help"]
